FROM nvidia/cuda:12.6.3-devel-ubuntu24.04

ARG ROS_DISTRO=jazzy
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Setup locales, base utilities, and ROS 2 apt repository
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        gnupg2 \
        locales \
        lsb-release \
        python3-pip \
        python3-venv \
        software-properties-common \
        wget \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && add-apt-repository universe \
    && export ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F\" '{print $4}') \
    && curl -fsSL -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb" \
    && dpkg -i /tmp/ros2-apt-source.deb \
    && rm -f /tmp/ros2-apt-source.deb

# Install ROS 2 packages and build tooling
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        python3-colcon-common-extensions \
        python3-vcstool \
        ros-${ROS_DISTRO}-compressed-image-transport \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-ros-gz-interfaces \
        ros-${ROS_DISTRO}-rqt-image-view \
        ros-dev-tools

# Initialize Python virtual environment with system site packages
RUN python3 -m venv --system-site-packages "$VIRTUAL_ENV" \
    && pip install --no-cache-dir --upgrade pip

WORKDIR /workspace

COPY smolvla_ur10e_lerobot.repos src/smolvla_ur10e_lerobot.repos
COPY smolvla_ur10e_lerobot_requirements.txt src/smolvla_ur10e_lerobot_requirements.txt

# Clone external repositories
RUN vcs import src < src/smolvla_ur10e_lerobot.repos

# Install ROS system dependencies via rosdep
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && (rosdep init || true) \
    && rosdep update \
    && rosdep install --from-paths src --ignore-src -y -r

# Install pip requirements and editable packages
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r src/smolvla_ur10e_lerobot_requirements.txt \
    && pip install -e ./src/ros2smolvla_interface_camera \
    && pip install -e ./src/ros2smolvla_interface_lerobot/lerobot_robot_ros \
    && pip install -e ./src/ros2smolvla_interface_lerobot/lerobot_teleoperator_devices

# Evaluate ROS_DISTRO during build
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc

# Keep the heredoc quoted so internal bash variables ($1, $x, etc.) are protected
RUN cat <<'EOF' >> /root/.bashrc
reset_cube() {
  x=${1:-0.75}
  y=${2:-0.0}
  z=${3:-0.05}
  ros2 service call /world/default/set_pose ros_gz_interfaces/srv/SetEntityPose "{entity: {name: \"grip_box\", type: 2}, pose: {position: {x: $x, y: $y, z: $z}, orientation: {w: 1.0}}}"
}

alias telopreal="lerobot-teleoperate --robot.type=ur_10e_real --teleop.type=gamepad_6dof --display_data=false"
alias telopsim="lerobot-teleoperate --robot.type=ur_10e_sim --teleop.type=gamepad_6dof --display_data=false"
EOF

CMD ["sleep", "infinity"]