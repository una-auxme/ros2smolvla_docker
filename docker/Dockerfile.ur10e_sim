ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all

# Install build tools and graphics libraries
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        git \
        libegl1 \
        libgl1 \
        libglvnd0 \
        libglx0 \
        libx11-6 \
        libxext6 \
        mesa-utils \
        python3-colcon-common-extensions \
        python3-vcstool \
        wget

WORKDIR /ros2_ws

COPY smolvla_ur10e_sim.repos src/smolvla_ur10e_sim.repos

# Clone external repositories
RUN vcs import src < src/smolvla_ur10e_sim.repos

# Install dependencies using rosdep
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    . /opt/ros/${ROS_DISTRO}/setup.sh \
    && apt-get update \
    && rosdep update \
    && rosdep install --from-paths src --ignore-src -y

# Build the workspace
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && colcon build \
        --symlink-install \
        --packages-skip cartesian_controller_simulation cartesian_controller_tests cartesian_compliance_controller cartesian_force_controller \
        --cmake-args -DCMAKE_BUILD_TYPE=Release

# Setup bashrc with ROS sourcing and helper functions
RUN cat <<'EOF' >> /root/.bashrc
source /ros2_ws/install/setup.bash

reset_cube() {
  x=${1:-0.75}
  y=${2:-0.0}
  z=${3:-0.05}
  ros2 service call /world/default/set_pose ros_gz_interfaces/srv/SetEntityPose "{entity: {name: \"grip_box\", type: 2}, pose: {position: {x: $x, y: $y, z: $z}, orientation: {w: 1.0}}}"
}
EOF

CMD ["sleep", "infinity"]